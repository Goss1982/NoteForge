# Copy to .env; never commit the completed file.
# Use URL-safe generated values. The PostgreSQL password is interpolated in a URL.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-value
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SECRET_KEY=replace-with-at-least-32-random-characters
# Must match the exact origin used in the browser, including port when present.
PUBLIC_URL=http://localhost:3000
# For local HTTP only. Use true with HTTPS in Coolify.
COOKIE_SECURE=false
WEB_BIND=127.0.0.1
WEB_PORT=3000
# Leave blank until configured. No fake OCR is substituted.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
SYNC_INTERVAL_SECONDS=300
# Set to empty to disable automatic document generation.
AUTO_DOCUMENT_TYPE=meeting_minutes
MAX_UPLOAD_MB=40
MAX_PAGES=100
